@model Cliente
@{
    ViewData["Title"] = Model.NombreCompleto;
}

<div class="mb-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div>
        <h1 class="h3 mb-1">@Model.NombreCompleto</h1>
        <span class="badge @(Model.Activo ? "badge-elara-success" : "badge-elara-danger")">
            @(Model.Activo ? "Activo" : "Inactivo")
        </span>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Clientes" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-elara">
            <i class="bi bi-pencil me-1"></i> Editar
        </a>
        <a asp-controller="Clientes" asp-action="Index" class="btn btn-outline-elara">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-md-4">
        <div class="card card-elara text-center">
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.FotoUrl))
                {
                    <img src="@Model.FotoUrl" alt="@Model.NombreCompleto" class="elara-avatar-img mb-3" style="width:160px;height:160px;" />
                }
                else
                {
                    <div class="elara-avatar-placeholder mb-3 mx-auto" style="width:160px;height:160px;font-size:3.5rem;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                }
                <p class="text-elara-muted small mb-0">
                    <i class="bi bi-calendar2-check me-1"></i>
                    Cliente desde @Model.FechaRegistro.ToString("dd/MM/yyyy")
                </p>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-8">
        <div class="card card-elara mb-4">
            <div class="card-body">
                <h5 class="card-title font-heading mb-3">Información de contacto</h5>
                <dl class="row mb-0">
                    <dt class="col-12 col-sm-4 text-elara-muted">Teléfono</dt>
                    <dd class="col-12 col-sm-8"><i class="bi bi-telephone me-1"></i>@Model.Telefono</dd>

                    <dt class="col-12 col-sm-4 text-elara-muted">Correo</dt>
                    <dd class="col-12 col-sm-8"><i class="bi bi-envelope me-1"></i>@Model.Email</dd>

                    <dt class="col-12 col-sm-4 text-elara-muted">Fecha de nacimiento</dt>
                    <dd class="col-12 col-sm-8">@(Model.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "No registrada")</dd>
                </dl>
            </div>
        </div>

        <div class="card card-elara mb-4">
            <div class="card-body">
                <h5 class="card-title font-heading mb-3">Alergias o condiciones especiales</h5>
                <p class="mb-0">@(string.IsNullOrWhiteSpace(Model.Alergias) ? "Sin registrar." : Model.Alergias)</p>
            </div>
        </div>

        <div class="card card-elara">
            <div class="card-body">
                <h5 class="card-title font-heading mb-3">Preferencias</h5>
                <p class="mb-0">@(string.IsNullOrWhiteSpace(Model.Preferencias) ? "Sin registrar." : Model.Preferencias)</p>
            </div>
        </div>
    </div>
</div>

<div class="card card-elara mt-4">
    <div class="card-body">
        <h5 class="card-title font-heading mb-3">
            <i class="bi bi-calendar2-week me-1"></i> Historial de citas
        </h5>
        @*
            Espacio preparado para el módulo de Citas: cuando exista la entidad Cita
            con FK a ClienteId, el ClientesController inyectará ICitaService para
            traer aquí las citas pasadas de este cliente (fecha, servicio,
            especialista y estado) y listarlas en lugar de este mensaje.
        *@
        <p class="text-elara-muted mb-0">
            Aún no hay historial de citas disponible. Este espacio se completará junto con el módulo de Citas.
        </p>
    </div>
</div>
