@model ClienteIndexViewModel

<div class="row g-4 stagger-fade-in" id="clientesGrid">
    @if (!Model.Clientes.Any())
    {
        <div class="col-12">
            <div class="card card-elara text-center py-5">
                <i class="bi bi-people fs-1 text-elara-accent"></i>
                <p class="text-elara-muted mt-3 mb-0">No se encontraron clientes.</p>
            </div>
        </div>
    }
    else
    {
        foreach (var cliente in Model.Clientes)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <div class="card card-elara h-100">
                    <div class="card-body text-center">
                        @if (!string.IsNullOrEmpty(cliente.FotoUrl))
                        {
                            <img src="@cliente.FotoUrl" alt="@cliente.NombreCompleto" class="elara-avatar-img mb-3" />
                        }
                        else
                        {
                            <div class="elara-avatar-placeholder mb-3">
                                <i class="bi bi-person-fill"></i>
                            </div>
                        }
                        <h5 class="card-title mb-1">@cliente.NombreCompleto</h5>
                        <p class="text-elara-muted small mb-2">
                            <i class="bi bi-telephone me-1"></i>@cliente.Telefono
                        </p>
                        <span class="badge @(cliente.Activo ? "badge-elara-success" : "badge-elara-danger") mb-3">
                            @(cliente.Activo ? "Activo" : "Inactivo")
                        </span>
                        <div class="d-flex gap-2 justify-content-center">
                            <a asp-controller="Clientes" asp-action="Details" asp-route-id="@cliente.Id"
                               class="btn btn-sm btn-outline-elara" title="Ver detalle">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-controller="Clientes" asp-action="Edit" asp-route-id="@cliente.Id"
                               class="btn btn-sm btn-outline-elara" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-controller="Clientes" asp-action="CambiarEstado" asp-route-id="@cliente.Id"
                                  asp-route-term="@Model.SearchTerm" asp-route-page="@Model.PageNumber"
                                  method="post" class="d-inline">
                                <button type="submit"
                                        class="btn btn-sm @(cliente.Activo ? "btn-outline-elara" : "btn-elara-success")"
                                        title="@(cliente.Activo ? "Desactivar" : "Activar")">
                                    <i class="bi @(cliente.Activo ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4" aria-label="Paginación de clientes">
        <ul class="pagination justify-content-center" id="clientesPagination">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                    <a class="page-link js-page-link" href="#" data-page="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}
