@model ClienteFormViewModel
@{
    ViewData["Title"] = "Nuevo cliente";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Nuevo cliente</h1>
    <p class="text-elara-muted">Registra los datos de la clienta.</p>
</div>

<div class="card card-elara" style="max-width: 760px;">
    <div class="card-body p-4">
        <div asp-validation-summary="ModelOnly" class="text-elara-accent mb-3"></div>
        <form asp-controller="Clientes" asp-action="Create" method="post" enctype="multipart/form-data">
            <partial name="_ClienteForm" model="Model" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-elara">
                    <i class="bi bi-check2 me-1"></i> Guardar cliente
                </button>
                <a asp-controller="Clientes" asp-action="Index" class="btn btn-outline-elara">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
