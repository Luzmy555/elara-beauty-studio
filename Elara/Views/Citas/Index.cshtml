@{
    ViewData["Title"] = "Citas";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h1 class="h3 mb-1">Citas</h1>
        <p class="text-elara-muted mb-0">Calendario de citas del salón. Arrastra una cita para reagendarla.</p>
    </div>
    <button type="button" class="btn btn-elara" id="btnNuevaCita">
        <i class="bi bi-calendar-plus me-1"></i> Nueva cita
    </button>
</div>

<form id="globalAntiForgeryForm" class="d-none">@Html.AntiForgeryToken()</form>

<div class="card card-elara p-3">
    <div id="calendario"></div>
</div>

<div class="modal fade" id="citaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-heading" id="citaModalTitle">Nueva cita</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="citaModalBody"></div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3" id="elaraToasts" style="z-index: 1090;"></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/locales-all.global.min.js"></script>
    <script>
        window.elaraCalendarioConfig = {
            eventosUrl: '@Url.Action("Eventos", "Citas")',
            puedeCrear: true,
            puedeArrastrar: true,
            formularioCreacionUrl: '@Url.Action("FormularioCreacion", "Citas")',
            formularioEdicionUrl: '@Url.Action("FormularioEdicion", "Citas")',
            reagendarUrl: '@Url.Action("Reagendar", "Citas")',
            cambiarEstadoUrl: '@Url.Action("CambiarEstado", "Citas")'
        };
    </script>
    <script src="~/js/citas.js" asp-append-version="true"></script>
}
