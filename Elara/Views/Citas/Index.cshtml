@{
    ViewData["Title"] = "Citas";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h1 class="h3 mb-1">Citas</h1>
        <p class="text-elara-muted mb-0">Selecciona un día para ver y gestionar las citas del salón.</p>
    </div>
    <button type="button" class="btn btn-elara" id="btnNuevaCita">
        <i class="bi bi-calendar-plus me-1"></i> Nueva cita
    </button>
</div>

<form id="globalAntiForgeryForm" class="d-none">@Html.AntiForgeryToken()</form>

<div class="card card-elara p-3">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <button type="button" class="btn btn-outline-elara btn-sm" id="btnFechaAnterior">
            <i class="bi bi-chevron-left"></i>
        </button>
        <input type="date" id="fechaSeleccionada" class="form-control form-control-sm" style="max-width: 170px;" />
        <button type="button" class="btn btn-outline-elara btn-sm" id="btnFechaSiguiente">
            <i class="bi bi-chevron-right"></i>
        </button>
        <button type="button" class="btn btn-outline-elara btn-sm" id="btnFechaHoy">Hoy</button>
    </div>
    <div id="listaCitas"></div>
</div>

<div class="modal fade" id="citaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-heading" id="citaModalTitle">Nueva cita</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="citaModalBody"></div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3" id="elaraToasts" style="z-index: 1090;"></div>

@section Scripts {
    <script>
        window.elaraCitasConfig = {
            eventosUrl: '@Url.Action("Eventos", "Citas")',
            puedeCrear: true,
            formularioCreacionUrl: '@Url.Action("FormularioCreacion", "Citas")',
            formularioEdicionUrl: '@Url.Action("FormularioEdicion", "Citas")',
            horariosDisponiblesUrl: '@Url.Action("HorariosDisponibles", "Citas")',
            reagendarUrl: '@Url.Action("Reagendar", "Citas")',
            cambiarEstadoUrl: '@Url.Action("CambiarEstado", "Citas")'
        };
    </script>
    <script src="~/js/citas.js" asp-append-version="true"></script>
}
