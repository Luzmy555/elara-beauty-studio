@model ProductoFormViewModel

<div class="row g-3">
    <div class="col-md-6 mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" autofocus placeholder="Ej: Esmalte OPI Rojo Pasión" />
        <span asp-validation-for="Nombre" class="text-elara-accent small"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Marca" class="form-label"></label>
        <input asp-for="Marca" class="form-control" />
        <span asp-validation-for="Marca" class="text-elara-accent small"></span>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4 mb-3">
        <label asp-for="Categoria" class="form-label"></label>
        <select asp-for="Categoria" class="form-select" asp-items="Html.GetEnumSelectList<CategoriaProducto>()"></select>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="UnidadMedida" class="form-label"></label>
        <select asp-for="UnidadMedida" class="form-select" asp-items="Html.GetEnumSelectList<UnidadMedida>()"></select>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="PrecioCosto" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">$</span>
            <input asp-for="PrecioCosto" type="number" min="0.01" step="0.01" class="form-control" />
        </div>
        <span asp-validation-for="PrecioCosto" class="text-elara-accent small"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="PrecioVenta" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">$</span>
            <input asp-for="PrecioVenta" type="number" min="0.01" step="0.01" class="form-control" />
        </div>
        <span asp-validation-for="PrecioVenta" class="text-elara-accent small"></span>
        <div class="form-text">Precio al público en Facturación.</div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4 mb-3">
        @if (Model.EsEdicion)
        {
            <label class="form-label">Cantidad actual</label>
            <input type="text" class="form-control" value="@Model.CantidadActual.ToString("0.##")" readonly />
            <div class="form-text">Se ajusta desde "Registrar movimiento" en el detalle del producto.</div>
        }
        else
        {
            <label asp-for="CantidadActual" class="form-label"></label>
            <input asp-for="CantidadActual" type="number" min="0" step="0.01" class="form-control" />
            <span asp-validation-for="CantidadActual" class="text-elara-accent small"></span>
        }
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="CantidadMinima" class="form-label"></label>
        <input asp-for="CantidadMinima" type="number" min="0.01" step="0.01" class="form-control" />
        <span asp-validation-for="CantidadMinima" class="text-elara-accent small"></span>
        <div class="form-text">Dispara la alerta de reabastecimiento.</div>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Proveedor" class="form-label"></label>
        <input asp-for="Proveedor" class="form-control" />
    </div>
</div>

<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="EsEdicion" />
