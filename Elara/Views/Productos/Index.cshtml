@model ProductoIndexViewModel
@{
    ViewData["Title"] = "Inventario";
    var categorias = Enum.GetValues<CategoriaProducto>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h1 class="h3 mb-1">Inventario</h1>
        <p class="text-elara-muted mb-0">Esmaltes, insumos y herramientas del salón.</p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.TotalBajoStock > 0)
        {
            <a asp-controller="Productos" asp-action="Reabastecer" class="btn btn-elara-danger">
                <i class="bi bi-exclamation-triangle me-1"></i> @Model.TotalBajoStock por reabastecer
            </a>
        }
        <a asp-controller="Productos" asp-action="Create" class="btn btn-elara">
            <i class="bi bi-plus-lg me-1"></i> Nuevo producto
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert badge-elara-success mb-4">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert badge-elara-danger mb-4">@TempData["ErrorMessage"]</div>
}

<form method="get" asp-controller="Productos" asp-action="Index" class="row g-2 mb-4">
    <div class="col-12 col-md-4">
        <input type="text" name="term" class="form-control" placeholder="Buscar por nombre o marca..." value="@Model.Term" />
    </div>
    <div class="col-8 col-md-3">
        <select name="categoria" class="form-select">
            <option value="">Todas las categorías</option>
            @foreach (var categoria in categorias)
            {
                <option value="@categoria" selected="@(Model.CategoriaSeleccionada == categoria.ToString())">@categoria</option>
            }
        </select>
    </div>
    <div class="col-4 col-md-2">
        <button type="submit" class="btn btn-outline-elara w-100">
            <i class="bi bi-search"></i> Filtrar
        </button>
    </div>
</form>

<div class="card card-elara">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th>Marca</th>
                    <th>Stock</th>
                    <th>Precio costo</th>
                    <th>Proveedor</th>
                    <th>Última compra</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Productos.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-elara-muted py-5">
                            No se encontraron productos con ese filtro.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var producto in Model.Productos)
                    {
                        var nivel = Producto.CalcularNivelStock(producto.CantidadActual, producto.CantidadMinima);
                        var filaClase = nivel switch
                        {
                            NivelStock.Bajo => "elara-row-bajo",
                            NivelStock.Cerca => "elara-row-cerca",
                            _ => ""
                        };
                        var badgeClase = nivel switch
                        {
                            NivelStock.Bajo => "badge-elara-danger",
                            NivelStock.Cerca => "badge-elara-pending",
                            _ => "badge-elara-success"
                        };
                        var badgeTexto = nivel switch
                        {
                            NivelStock.Bajo => "Bajo mínimo",
                            NivelStock.Cerca => "Cerca del mínimo",
                            _ => "Stock OK"
                        };

                        <tr class="@filaClase">
                            <td>@producto.Nombre</td>
                            <td><span class="badge bg-elara-blush text-elara-accent">@producto.Categoria</span></td>
                            <td>@producto.Marca</td>
                            <td>
                                @producto.CantidadActual.ToString("0.##") @producto.UnidadMedida
                                <span class="text-elara-muted small">(mín. @producto.CantidadMinima.ToString("0.##"))</span>
                            </td>
                            <td>$@producto.PrecioCosto.ToString("0.00")</td>
                            <td>@(producto.Proveedor ?? "—")</td>
                            <td>@(producto.FechaUltimaCompra?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td><span class="badge @badgeClase">@badgeTexto</span></td>
                            <td class="text-end">
                                <a asp-controller="Productos" asp-action="Details" asp-route-id="@producto.Id"
                                   class="btn btn-sm btn-outline-elara" title="Ver / movimientos">
                                    <i class="bi bi-clock-history"></i>
                                </a>
                                <a asp-controller="Productos" asp-action="Edit" asp-route-id="@producto.Id"
                                   class="btn btn-sm btn-outline-elara" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
