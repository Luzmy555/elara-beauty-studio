@model Devolucion
@{
    ViewData["Title"] = "Devolución " + Model.NumeroDevolucion;
    Layout = "_PrintLayout";
}

<div class="elara-invoice">
    <div class="elara-invoice-actions no-print">
        <button type="button" class="btn btn-elara" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Imprimir / Guardar PDF
        </button>
        @if (Model.FacturaDetalle != null)
        {
            <a asp-controller="Facturas" asp-action="Details" asp-route-id="@Model.FacturaDetalle.FacturaId" class="btn btn-outline-elara">
                <i class="bi bi-arrow-left me-1"></i> Volver a la factura
            </a>
        }
    </div>

    <header class="elara-invoice-header">
        <div>
            <div class="elara-logo">Elara</div>
            <p class="text-elara-muted mb-0">Comprobante de devolución</p>
        </div>
        <div class="text-end">
            <h2 class="h4 mb-1">Devolución @Model.NumeroDevolucion</h2>
            <p class="mb-1">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
            @if (Model.FacturaDetalle?.Factura != null)
            {
                <p class="mb-0 text-elara-muted small">Factura original: @Model.FacturaDetalle.Factura.NumeroFactura</p>
            }
        </div>
    </header>

    <hr class="elara-divider" />

    <section class="elara-invoice-section">
        <div class="table-responsive">
            <table class="table elara-invoice-table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th class="text-end">Cantidad devuelta</th>
                        <th class="text-end">Monto reembolsado</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Model.FacturaDetalle?.Producto?.Nombre</td>
                        <td class="text-end">@Model.Cantidad</td>
                        <td class="text-end">$@Model.MontoReembolsado.ToString("0.00")</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="elara-invoice-totales">
            <div class="d-flex justify-content-between elara-invoice-total-final">
                <strong>Total reembolsado</strong>
                <strong>$@Model.MontoReembolsado.ToString("0.00")</strong>
            </div>
            <div class="d-flex justify-content-between text-elara-muted small mt-2">
                <span>Método de reembolso</span>
                <span>@Model.MetodoReembolso</span>
            </div>
        </div>

        <div class="mt-4">
            <h6 class="text-elara-muted text-uppercase small">Motivo</h6>
            <p class="mb-0">@Model.Motivo</p>
        </div>
    </section>

    <footer class="elara-invoice-footer">
        <p class="text-center text-elara-muted small mb-0">Elara — comprobante de devolución de producto</p>
    </footer>
</div>
