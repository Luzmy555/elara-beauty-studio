@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var isAdmin = User.IsInRole("Administrador");
}

<div class="mb-4">
    <h1 class="display-6 mb-1">Bienvenida a <span class="text-elara-accent">Elara</span></h1>
    <p class="text-elara-muted mb-0">Panel de gestión del salón de uñas</p>
</div>

<div class="row g-3 g-md-4 mb-4 stagger-fade-in">
    <div class="col-6 col-lg-3">
        <div class="card card-elara h-100">
            <div class="card-body">
                <i class="bi bi-calendar2-check fs-2 text-elara-accent"></i>
                <h5 class="card-title mt-3 mb-1">Citas de hoy</h5>
                <p class="fs-4 text-elara-accent mb-0">@Model.CitasHoy</p>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card card-elara h-100">
            <div class="card-body">
                <i class="bi bi-cash-coin fs-2 text-elara-accent"></i>
                <h5 class="card-title mt-3 mb-1">Ingresos del día</h5>
                <p class="fs-4 text-elara-accent mb-0">$@Model.IngresosHoy.ToString("0.00")</p>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card card-elara h-100">
            <div class="card-body">
                <i class="bi bi-person-plus fs-2 text-elara-accent"></i>
                <h5 class="card-title mt-3 mb-1">Clientes nuevos (semana)</h5>
                <p class="fs-4 text-elara-accent mb-0">@Model.ClientesNuevosSemana</p>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        @if (isAdmin)
        {
            <a asp-controller="Productos" asp-action="Reabastecer" class="text-decoration-none">
                <div class="card card-elara h-100 @(Model.ProductosPorReabastecer > 0 ? "border-elara-danger" : "")">
                    <div class="card-body">
                        <i class="bi bi-boxes fs-2 @(Model.ProductosPorReabastecer > 0 ? "text-elara-danger" : "text-elara-accent")"></i>
                        <h5 class="card-title mt-3 mb-1">Alertas de inventario</h5>
                        <p class="fs-4 mb-0 @(Model.ProductosPorReabastecer > 0 ? "text-elara-danger" : "text-elara-accent")">
                            @Model.ProductosPorReabastecer
                        </p>
                    </div>
                </div>
            </a>
        }
        else
        {
            <div class="card card-elara h-100 @(Model.ProductosPorReabastecer > 0 ? "border-elara-danger" : "")">
                <div class="card-body">
                    <i class="bi bi-boxes fs-2 @(Model.ProductosPorReabastecer > 0 ? "text-elara-danger" : "text-elara-accent")"></i>
                    <h5 class="card-title mt-3 mb-1">Alertas de inventario</h5>
                    <p class="fs-4 mb-0 @(Model.ProductosPorReabastecer > 0 ? "text-elara-danger" : "text-elara-accent")">
                        @Model.ProductosPorReabastecer
                    </p>
                </div>
            </div>
        }
    </div>
</div>

<div class="row g-3 g-md-4 mb-4 stagger-fade-in">
    <div class="col-6 col-md-3">
        <a asp-controller="Citas" asp-action="Index" class="text-decoration-none">
            <div class="card card-elara h-100 text-center">
                <div class="card-body py-4">
                    <i class="bi bi-calendar2-plus fs-1 text-elara-accent d-block mb-2"></i>
                    <span class="fw-medium text-elara-text">Nueva Cita</span>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a asp-controller="Clientes" asp-action="Create" class="text-decoration-none">
            <div class="card card-elara h-100 text-center">
                <div class="card-body py-4">
                    <i class="bi bi-person-plus fs-1 text-elara-accent d-block mb-2"></i>
                    <span class="fw-medium text-elara-text">Nuevo Cliente</span>
                </div>
            </div>
        </a>
    </div>
    @if (isAdmin)
    {
        <div class="col-6 col-md-3">
            <a asp-controller="Productos" asp-action="Index" class="text-decoration-none">
                <div class="card card-elara h-100 text-center">
                    <div class="card-body py-4">
                        <i class="bi bi-boxes fs-1 text-elara-accent d-block mb-2"></i>
                        <span class="fw-medium text-elara-text">Ver Inventario</span>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-controller="Reportes" asp-action="Index" class="text-decoration-none">
                <div class="card card-elara h-100 text-center">
                    <div class="card-body py-4">
                        <i class="bi bi-graph-up fs-1 text-elara-accent d-block mb-2"></i>
                        <span class="fw-medium text-elara-text">Ver Reportes</span>
                    </div>
                </div>
            </a>
        </div>
    }
</div>

<div class="card card-elara stagger-fade-in">
    <div class="card-body">
        <h5 class="card-title font-heading mb-3">Próximas citas de hoy</h5>

        @if (!Model.ProximasCitasHoy.Any())
        {
            <p class="text-elara-muted mb-0">No hay más citas programadas para hoy.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr class="text-elara-muted small">
                            <th>Hora</th>
                            <th>Cliente</th>
                            <th>Servicio</th>
                            <th>Empleado</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cita in Model.ProximasCitasHoy)
                        {
                            var badgeClass = cita.Estado switch
                            {
                                "Completada" => "badge-elara-success",
                                "Cancelada" or "NoAsistio" => "badge-elara-danger",
                                _ => "badge-elara-pending"
                            };
                            <tr>
                                <td class="fw-medium">@cita.FechaHoraInicio.ToString("hh:mm tt")</td>
                                <td>@cita.Cliente</td>
                                <td>@cita.Servicio</td>
                                <td>@cita.Empleado</td>
                                <td><span class="badge @badgeClass">@cita.Estado</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
