@model IEnumerable<Servicio>
@{
    ViewData["Title"] = "Servicios";
    var categorias = (List<CategoriaServicio>)ViewBag.Categorias;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h1 class="h3 mb-1">Catálogo de servicios</h1>
        <p class="text-elara-muted mb-0">Servicios que ofrece el salón, con duración y precio.</p>
    </div>
    @if (User.IsInRole("Administrador"))
    {
        <a asp-controller="Servicios" asp-action="Create" class="btn btn-elara">
            <i class="bi bi-plus-lg me-1"></i> Nuevo servicio
        </a>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert badge-elara-success mb-4">@TempData["SuccessMessage"]</div>
}

<div class="mb-3">
    <div class="input-group" style="max-width: 420px;">
        <span class="input-group-text bg-elara-ivory"><i class="bi bi-search"></i></span>
        <input type="text" id="servicioSearchInput" class="form-control"
               placeholder="Buscar servicio por nombre..." autocomplete="off" />
    </div>
</div>

<div class="mb-4 d-flex flex-wrap gap-2" id="categoriaFiltros">
    <button type="button" class="btn btn-sm btn-elara elara-pill" data-categoria="todos">Todos</button>
    @foreach (var categoria in categorias)
    {
        <button type="button" class="btn btn-sm btn-outline-elara elara-pill" data-categoria="@categoria.Nombre">@categoria.Nombre</button>
    }
</div>

<div class="row g-4 stagger-fade-in" id="serviciosGrid">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card card-elara text-center py-5">
                <i class="bi bi-gem fs-1 text-elara-accent"></i>
                <p class="text-elara-muted mt-3 mb-0">Aún no hay servicios registrados.</p>
            </div>
        </div>
    }
    else
    {
        foreach (var servicio in Model)
        {
            <div class="col-12 col-sm-6 col-lg-4" data-categoria="@servicio.CategoriaServicio?.Nombre" data-nombre="@servicio.Nombre.ToLower()">
                <div class="card card-elara h-100 overflow-hidden">
                    @if (!string.IsNullOrEmpty(servicio.ImagenUrl))
                    {
                        <img src="@servicio.ImagenUrl" alt="@servicio.Nombre" class="elara-service-image card-img-top" />
                    }
                    else
                    {
                        <div class="elara-service-image elara-service-image-placeholder">
                            <i class="bi bi-gem"></i>
                        </div>
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-elara-blush text-elara-accent">@servicio.CategoriaServicio?.Nombre</span>
                            <span class="badge @(servicio.Activo ? "badge-elara-success" : "badge-elara-danger")">
                                @(servicio.Activo ? "Activo" : "Inactivo")
                            </span>
                        </div>
                        <h5 class="card-title mb-1">@servicio.Nombre</h5>
                        <p class="text-elara-muted small mb-3">@servicio.Descripcion</p>
                        <div class="d-flex justify-content-between align-items-center mb-3 mt-auto">
                            <span class="text-elara-muted small">
                                <i class="bi bi-clock me-1"></i>@servicio.DuracionMinutos min
                            </span>
                            <span class="elara-price-tag">$@servicio.Precio.ToString("0.00")</span>
                        </div>
                        @if (User.IsInRole("Administrador"))
                        {
                            <div class="d-flex gap-2">
                                <a asp-controller="Servicios" asp-action="Edit" asp-route-id="@servicio.Id"
                                   class="btn btn-sm btn-outline-elara flex-fill">
                                    <i class="bi bi-pencil"></i> Editar
                                </a>
                                <form asp-controller="Servicios" asp-action="CambiarEstado" asp-route-id="@servicio.Id" method="post" class="flex-fill">
                                    <button type="submit" class="btn btn-sm w-100 @(servicio.Activo ? "btn-outline-elara" : "btn-elara-success")">
                                        <i class="bi @(servicio.Activo ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                        @(servicio.Activo ? "Desactivar" : "Activar")
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>
<p class="text-elara-muted text-center py-5" id="sinResultadosServicios" style="display:none;">No se encontraron servicios con ese nombre o categoría.</p>

@section Scripts {
    <script src="~/js/servicios.js" asp-append-version="true"></script>
}
