@model Factura
@{
    ViewData["Title"] = "Factura " + Model.NumeroFactura;
    Layout = "_PrintLayout";

    var nombreCliente = Model.Cliente?.NombreCompleto ?? "Cliente sin registrar";
}

<div class="elara-invoice">
    <div class="elara-invoice-actions no-print">
        <button type="button" class="btn btn-elara" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Imprimir / Guardar PDF
        </button>
        <a asp-controller="Facturas" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-elara">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>

    <header class="elara-invoice-header">
        <div>
            <div class="elara-logo">Elara</div>
            <p class="text-elara-muted mb-0">Salón de uñas de lujo</p>
        </div>
        <div class="text-end">
            <h2 class="h4 mb-1">Factura @Model.NumeroFactura</h2>
            <p class="mb-1">@Model.FechaEmision.ToString("dd/MM/yyyy HH:mm")</p>
            <span class="badge @(Model.Estado == EstadoFactura.Pagada ? "badge-elara-success" : "badge-elara-pending")">
                @Model.Estado
            </span>
        </div>
    </header>

    <hr class="elara-divider" />

    <section class="elara-invoice-section">
        <div class="row">
            <div class="col-6">
                <h6 class="text-elara-muted text-uppercase small">Cliente</h6>
                <p class="mb-0 fw-semibold">@nombreCliente</p>
                <p class="mb-0">@(Model.Cliente?.Telefono ?? Model.ClienteTelefonoContacto)</p>
            </div>
        </div>
    </section>

    <section class="elara-invoice-section">
        <table class="table elara-invoice-table">
            <thead>
                <tr>
                    <th>Servicio</th>
                    <th>Especialista</th>
                    <th class="text-end">Cant.</th>
                    <th class="text-end">Precio</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detalle in Model.FacturaDetalles)
                {
                    <tr>
                        <td>@detalle.Servicio?.Nombre</td>
                        <td>@detalle.Empleado?.NombreCompleto</td>
                        <td class="text-end">@detalle.Cantidad</td>
                        <td class="text-end">$@detalle.Subtotal.ToString("0.00")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="elara-invoice-totales">
            <div class="d-flex justify-content-between">
                <span>Subtotal</span>
                <span>$@Model.Subtotal.ToString("0.00")</span>
            </div>
            @if (Model.Descuento > 0)
            {
                <div class="d-flex justify-content-between text-elara-danger">
                    <span>Descuento @(!string.IsNullOrEmpty(Model.DescuentoJustificacion) ? $"({Model.DescuentoJustificacion})" : "")</span>
                    <span>-$@Model.Descuento.ToString("0.00")</span>
                </div>
            }
            <div class="d-flex justify-content-between elara-invoice-total-final">
                <strong>Total</strong>
                <strong>$@Model.Total.ToString("0.00")</strong>
            </div>
            <div class="d-flex justify-content-between text-elara-muted small mt-2">
                <span>Método de pago</span>
                <span>@Model.MetodoPago</span>
            </div>
        </div>
    </section>

    <footer class="elara-invoice-footer">
        <p class="text-center text-elara-muted small mb-0">Gracias por tu preferencia — Elara</p>
    </footer>
</div>
