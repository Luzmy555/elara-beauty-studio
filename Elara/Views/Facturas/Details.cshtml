@model Factura
@using ElaraMVC.Services
@{
    ViewData["Title"] = "Factura " + Model.NumeroFactura;

    var nombreCliente = Model.Cliente?.NombreCompleto ?? "Cliente sin registrar";
    var telefonoWhatsApp = Model.Cliente?.Telefono ?? Model.ClienteTelefonoContacto;
    var mensajeWhatsApp = WhatsAppLinkHelper.ConstruirMensajeFactura(Model, nombreCliente);
    var whatsappUrl = WhatsAppLinkHelper.ConstruirLink(telefonoWhatsApp, mensajeWhatsApp);
    var todasLasDevoluciones = Model.FacturaDetalles.SelectMany(d => d.Devoluciones).OrderByDescending(d => d.Fecha).ToList();
}

<div class="mb-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div>
        <h1 class="h3 mb-1">Factura @Model.NumeroFactura</h1>
        <span class="badge @(Model.Estado == EstadoFactura.Pagada ? "badge-elara-success" : "badge-elara-pending")">@Model.Estado</span>
        <span class="badge bg-secondary">@(Model.CitaId.HasValue ? "Desde cita" : "Venta rápida")</span>
    </div>
    <div class="d-flex gap-2">
        @if (whatsappUrl != null)
        {
            <a href="@whatsappUrl" target="_blank" rel="noopener" class="btn btn-success">
                <i class="bi bi-whatsapp me-1"></i> Abrir WhatsApp con el mensaje
            </a>
        }
        <a asp-controller="Facturas" asp-action="Imprimir" asp-route-id="@Model.Id" target="_blank" class="btn btn-elara">
            <i class="bi bi-printer me-1"></i> Ver / Imprimir
        </a>
        <a asp-controller="Facturas" asp-action="ReporteCaja" class="btn btn-outline-elara">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert badge-elara-success mb-4">@TempData["SuccessMessage"]</div>
}

@if (whatsappUrl != null)
{
    <p class="text-elara-muted small mt-n3 mb-4">
        <i class="bi bi-info-circle me-1"></i>
        El botón abre WhatsApp (Web o app) con el mensaje ya escrito — todavía debes presionar "Enviar" dentro de WhatsApp para que le llegue al cliente. Esto no se puede automatizar sin contratar la API oficial de WhatsApp Business.
    </p>
}

<div class="row g-4">
    <div class="col-12 col-md-6">
        <div class="card card-elara">
            <div class="card-body">
                <h5 class="card-title font-heading mb-3">Detalle</h5>
                <dl class="row mb-3">
                    <dt class="col-5 text-elara-muted">Cliente</dt>
                    <dd class="col-7">@nombreCliente</dd>

                    <dt class="col-5 text-elara-muted">Fecha de emisión</dt>
                    <dd class="col-7">@Model.FechaEmision.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-5 text-elara-muted">Método de pago</dt>
                    <dd class="col-7">@Model.MetodoPago</dd>
                </dl>

                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Concepto</th>
                                <th>Especialista</th>
                                <th class="text-end">Cant.</th>
                                <th class="text-end">Subtotal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detalle in Model.FacturaDetalles)
                            {
                                var yaDevuelto = detalle.Devoluciones.Sum(d => d.Cantidad);
                                var disponibleParaDevolver = detalle.Cantidad - yaDevuelto;
                                <tr>
                                    <td>
                                        @(detalle.Servicio?.Nombre ?? detalle.Producto?.Nombre)
                                        @if (detalle.ProductoId.HasValue)
                                        {
                                            <span class="badge bg-secondary ms-1">Producto</span>
                                        }
                                        @if (yaDevuelto > 0)
                                        {
                                            <div class="text-elara-muted small">Devuelto: @yaDevuelto de @detalle.Cantidad</div>
                                        }
                                    </td>
                                    <td>@(detalle.Empleado?.NombreCompleto ?? "—")</td>
                                    <td class="text-end">@detalle.Cantidad</td>
                                    <td class="text-end">$@detalle.Subtotal.ToString("0.00")</td>
                                    <td class="text-end">
                                        @if (detalle.ProductoId.HasValue && disponibleParaDevolver > 0)
                                        {
                                            <a asp-controller="Devoluciones" asp-action="Crear" asp-route-facturaDetalleId="@detalle.Id" class="btn btn-sm btn-outline-elara">
                                                <i class="bi bi-arrow-return-left"></i> Devolver
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (Model.MetodoPago == MetodoPago.Transferencia)
        {
            <div class="card card-elara mt-4">
                <div class="card-body">
                    <h5 class="card-title font-heading mb-3">Comprobante de transferencia</h5>
                    @if (!string.IsNullOrEmpty(Model.ComprobanteTransferenciaUrl))
                    {
                        <a href="@Model.ComprobanteTransferenciaUrl" target="_blank">
                            <img src="@Model.ComprobanteTransferenciaUrl" alt="Comprobante de transferencia" class="img-fluid rounded" style="max-height: 240px;" />
                        </a>
                    }
                    else
                    {
                        <p class="text-elara-muted small">No se ha adjuntado un comprobante todavía.</p>
                        <form asp-controller="Facturas" asp-action="SubirComprobante" method="post" enctype="multipart/form-data" class="d-flex gap-2">
                            <input type="hidden" name="facturaId" value="@Model.Id" />
                            <input type="file" name="archivo" accept="image/*" class="form-control" required />
                            <button type="submit" class="btn btn-elara text-nowrap">
                                <i class="bi bi-upload me-1"></i> Subir
                            </button>
                        </form>
                    }
                </div>
            </div>
        }

        @if (todasLasDevoluciones.Any())
        {
            <div class="card card-elara mt-4">
                <div class="card-body">
                    <h5 class="card-title font-heading mb-3">Devoluciones de esta factura</h5>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr>
                                    <th>N°</th>
                                    <th>Fecha</th>
                                    <th class="text-end">Cantidad</th>
                                    <th class="text-end">Monto</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var devolucion in todasLasDevoluciones)
                                {
                                    <tr>
                                        <td>@devolucion.NumeroDevolucion</td>
                                        <td>@devolucion.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-end">@devolucion.Cantidad</td>
                                        <td class="text-end">$@devolucion.MontoReembolsado.ToString("0.00")</td>
                                        <td class="text-end">
                                            <a asp-controller="Devoluciones" asp-action="Imprimir" asp-route-id="@devolucion.Id" target="_blank" class="btn btn-sm btn-outline-elara">
                                                <i class="bi bi-printer"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="col-12 col-md-6">
        <div class="card card-elara">
            <div class="card-body">
                <h5 class="card-title font-heading mb-3">Totales</h5>
                <div class="d-flex justify-content-between mb-1">
                    <span>Subtotal</span>
                    <span>$@Model.Subtotal.ToString("0.00")</span>
                </div>
                @if (Model.Descuento > 0)
                {
                    <div class="d-flex justify-content-between mb-1 text-elara-danger">
                        <span>Descuento</span>
                        <span>-$@Model.Descuento.ToString("0.00")</span>
                    </div>
                    <p class="text-elara-muted small">@Model.DescuentoJustificacion</p>
                }
                <div class="d-flex justify-content-between fw-bold fs-5 text-elara-accent border-top pt-2 mt-2">
                    <span>Total</span>
                    <span>$@Model.Total.ToString("0.00")</span>
                </div>

                @if (Model.MontoRecibido.HasValue)
                {
                    <div class="d-flex justify-content-between mt-2 text-elara-muted small">
                        <span>Monto recibido</span>
                        <span>$@Model.MontoRecibido.Value.ToString("0.00")</span>
                    </div>
                    <div class="d-flex justify-content-between fw-semibold">
                        <span>Devuelta</span>
                        <span>$@Model.Devuelta!.Value.ToString("0.00")</span>
                    </div>
                }

                @if (User.IsInRole("Administrador"))
                {
                    <hr class="elara-divider" />
                    <h6 class="text-elara-muted text-uppercase small mb-2">Comisiones</h6>
                    @foreach (var detalle in Model.FacturaDetalles)
                    {
                        <div class="d-flex justify-content-between text-elara-muted small">
                            <span>@detalle.Empleado?.NombreCompleto</span>
                            <span>$@detalle.ComisionEmpleado.ToString("0.00")</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
