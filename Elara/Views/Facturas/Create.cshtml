@model FacturaFormViewModel
@{
    ViewData["Title"] = "Generar factura";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Generar factura</h1>
    <p class="text-elara-muted">Cita completada — revisa los datos antes de emitir.</p>
</div>

<div class="card card-elara" style="max-width: 640px;">
    <div class="card-body p-4">
        <div asp-validation-summary="ModelOnly" class="text-elara-accent mb-3"></div>

        <dl class="row mb-4">
            <dt class="col-4 text-elara-muted">Cliente</dt>
            <dd class="col-8">@Model.ClienteNombre</dd>

            <dt class="col-4 text-elara-muted">Especialista</dt>
            <dd class="col-8">@Model.EmpleadoNombre</dd>

            <dt class="col-4 text-elara-muted">Servicio</dt>
            <dd class="col-8">@Model.ServicioNombre</dd>

            <dt class="col-4 text-elara-muted">Subtotal</dt>
            <dd class="col-8">$@Model.Subtotal.ToString("0.00")</dd>
        </dl>

        <form asp-controller="Facturas" asp-action="Create" method="post">
            <input type="hidden" asp-for="CitaId" />
            <input type="hidden" asp-for="ClienteNombre" />
            <input type="hidden" asp-for="EmpleadoNombre" />
            <input type="hidden" asp-for="ServicioNombre" />
            <input type="hidden" asp-for="Subtotal" id="subtotalInput" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Descuento" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Descuento" type="number" min="0" step="0.01" class="form-control" id="descuentoInput" />
                    </div>
                    <span asp-validation-for="Descuento" class="text-elara-accent small"></span>
                    <div class="form-text">Total: <strong id="totalPreview" class="text-elara-accent">$@Model.Subtotal.ToString("0.00")</strong></div>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="MetodoPago" class="form-label"></label>
                    <select asp-for="MetodoPago" class="form-select" asp-items="Html.GetEnumSelectList<MetodoPago>()"></select>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="DescuentoJustificacion" class="form-label"></label>
                <input asp-for="DescuentoJustificacion" class="form-control" placeholder="Obligatorio si aplicas un descuento" />
                <span asp-validation-for="DescuentoJustificacion" class="text-elara-accent small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Estado" class="form-label"></label>
                <select asp-for="Estado" class="form-select" asp-items="Html.GetEnumSelectList<EstadoFactura>()"></select>
                <div class="form-text">Marca "Pendiente" si el cliente pagará después.</div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-elara">
                    <i class="bi bi-receipt me-1"></i> Emitir factura
                </button>
                <a asp-controller="Citas" asp-action="Index" class="btn btn-outline-elara">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/facturas.js" asp-append-version="true"></script>
}
