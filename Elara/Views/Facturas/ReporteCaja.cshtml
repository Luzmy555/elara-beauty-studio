@model ReporteCajaViewModel
@{
    ViewData["Title"] = "Reporte de caja";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Reporte de caja</h1>
    <p class="text-elara-muted mb-0">Total facturado por método de pago.</p>
</div>

<form method="get" asp-controller="Facturas" asp-action="ReporteCaja" class="row g-2 mb-4">
    <div class="col-auto">
        <input type="date" name="fecha" class="form-control" value="@Model.Fecha.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-elara">
            <i class="bi bi-search me-1"></i> Ver fecha
        </button>
    </div>
</form>

<div class="row g-4 mb-4 stagger-fade-in">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card card-elara h-100">
            <div class="card-body">
                <i class="bi bi-cash-stack fs-2 text-elara-accent"></i>
                <h5 class="card-title mt-3 mb-1">Efectivo</h5>
                <p class="fs-4 text-elara-accent mb-0">$@Model.TotalEfectivo.ToString("0.00")</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card card-elara h-100">
            <div class="card-body">
                <i class="bi bi-credit-card fs-2 text-elara-accent"></i>
                <h5 class="card-title mt-3 mb-1">Tarjeta</h5>
                <p class="fs-4 text-elara-accent mb-0">$@Model.TotalTarjeta.ToString("0.00")</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card card-elara h-100">
            <div class="card-body">
                <i class="bi bi-bank fs-2 text-elara-accent"></i>
                <h5 class="card-title mt-3 mb-1">Transferencia</h5>
                <p class="fs-4 text-elara-accent mb-0">$@Model.TotalTransferencia.ToString("0.00")</p>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card card-elara h-100" style="background-color: var(--elara-charcoal);">
            <div class="card-body">
                <i class="bi bi-wallet2 fs-2" style="color: var(--elara-gold-soft);"></i>
                <h5 class="card-title mt-3 mb-1" style="color: var(--elara-ivory);">Total del día</h5>
                <p class="fs-4 mb-0" style="color: var(--elara-gold-soft);">$@Model.TotalGeneral.ToString("0.00")</p>
            </div>
        </div>
    </div>
</div>

@if (Model.TotalPendiente > 0)
{
    <div class="alert badge-elara-pending mb-4">
        <i class="bi bi-hourglass-split me-1"></i>
        Hay $@Model.TotalPendiente.ToString("0.00") en facturas marcadas como "Pendiente" (no incluidas en los totales de arriba).
    </div>
}

<div class="card card-elara">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Factura</th>
                    <th>Cliente</th>
                    <th>Especialista</th>
                    <th>Método</th>
                    <th>Estado</th>
                    <th class="text-end">Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Facturas.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-elara-muted py-5">No hay facturas en esta fecha.</td>
                    </tr>
                }
                else
                {
                    foreach (var factura in Model.Facturas)
                    {
                        <tr>
                            <td>#@factura.Id.ToString("D6")</td>
                            <td>@factura.Cliente?.NombreCompleto</td>
                            <td>@factura.Empleado?.NombreCompleto</td>
                            <td>@factura.MetodoPago</td>
                            <td>
                                <span class="badge @(factura.Estado == EstadoFactura.Pagada ? "badge-elara-success" : "badge-elara-pending")">
                                    @factura.Estado
                                </span>
                            </td>
                            <td class="text-end">$@factura.Total.ToString("0.00")</td>
                            <td class="text-end">
                                <a asp-controller="Facturas" asp-action="Details" asp-route-id="@factura.Id" class="btn btn-sm btn-outline-elara">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
