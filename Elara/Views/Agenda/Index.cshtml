@model Empleado?
@{
    ViewData["Title"] = "Mi Agenda";
    var hoy = DateTime.Today.DayOfWeek;
    var horarioHoy = Model?.Horarios.FirstOrDefault(h => h.DiaSemana == hoy);
}

<div class="mb-4">
    <h1 class="h3 mb-1">Mi Agenda</h1>
    <p class="text-elara-muted">Tus citas de hoy y esta semana.</p>
</div>

@if (Model == null)
{
    <div class="card card-elara mb-4">
        <div class="card-body text-center py-5">
            <i class="bi bi-exclamation-circle fs-1 text-elara-accent"></i>
            <p class="text-elara-muted mt-3 mb-0">
                Tu perfil de empleada aún no está vinculado. Contacta a un Administrador.
            </p>
        </div>
    </div>
}
else
{
    <div class="card card-elara mb-4">
        <div class="card-body">
            <h5 class="card-title font-heading mb-2">
                <i class="bi bi-sun me-1"></i> Horario de hoy
            </h5>
            @if (horarioHoy is { Trabaja: true })
            {
                <p class="mb-0">
                    Trabajas hoy de <strong>@horarioHoy.HoraInicio?.ToString(@"hh\:mm")</strong>
                    a <strong>@horarioHoy.HoraFin?.ToString(@"hh\:mm")</strong>.
                </p>
            }
            else
            {
                <p class="text-elara-muted mb-0">Hoy no tienes horario asignado.</p>
            }
        </div>
    </div>
}

<form id="globalAntiForgeryForm" class="d-none">@Html.AntiForgeryToken()</form>

<div class="card card-elara p-3">
    <div id="calendario"></div>
</div>

<div class="modal fade" id="citaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title font-heading" id="citaModalTitle">Detalle de la cita</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="citaModalBody"></div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3" id="elaraToasts" style="z-index: 1090;"></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@fullcalendar/core@6.1.15/locales/es.global.min.js"></script>
    <script>
        window.elaraCalendarioConfig = {
            eventosUrl: '@Url.Action("Eventos", "Agenda")',
            puedeCrear: false,
            puedeArrastrar: false,
            cambiarEstadoUrl: '@Url.Action("CambiarEstado", "Agenda")'
        };
    </script>
    <script src="~/js/citas.js" asp-append-version="true"></script>
}
