@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}

<h2 class="h4 mb-1">Recuperar contraseña</h2>
<p class="text-elara-muted mb-4">
    Ingresa tu correo y te mostraremos un enlace para restablecerla
    (flujo simulado, sin envío real de correo por ahora).
</p>

<div asp-validation-summary="ModelOnly" class="text-elara-accent mb-3"></div>

<form asp-controller="Account" asp-action="ForgotPassword" method="post">
    <div class="mb-4">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autofocus />
        <span asp-validation-for="Email" class="text-elara-accent small"></span>
    </div>
    <button type="submit" class="btn btn-elara w-100 mb-3">Enviar enlace de recuperación</button>
    <div class="text-center">
        <a asp-controller="Account" asp-action="Login" class="small">Volver a iniciar sesión</a>
    </div>
</form>
