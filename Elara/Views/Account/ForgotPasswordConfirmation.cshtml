@{
    ViewData["Title"] = "Enlace enviado";
    var resetLink = TempData["SimulatedResetLink"] as string;
}

<div class="text-center mb-3">
    <i class="bi bi-envelope-check fs-1 text-elara-accent"></i>
</div>
<h2 class="h4 text-center mb-2">Solicitud recibida</h2>
<p class="text-elara-muted text-center mb-4">
    Si el correo existe en nuestro sistema, se generó un enlace de recuperación.
</p>

@if (!string.IsNullOrEmpty(resetLink))
{
    <div class="alert bg-elara-blush">
        <strong>Modo simulado</strong> (sin envío real de correo): usa este enlace para continuar.
        <div class="mt-2">
            <a href="@resetLink" class="text-break">@resetLink</a>
        </div>
    </div>
}

<div class="text-center">
    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-elara">Volver a iniciar sesión</a>
</div>
