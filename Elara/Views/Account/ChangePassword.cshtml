@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<h2 class="h4 mb-1">Actualiza tu contraseña</h2>
<p class="text-elara-muted mb-4">
    Por seguridad, debes cambiar tu contraseña temporal antes de continuar.
</p>

<div asp-validation-summary="ModelOnly" class="text-elara-accent mb-3"></div>

<form asp-controller="Account" asp-action="ChangePassword" method="post">
    <div class="mb-3">
        <label asp-for="CurrentPassword" class="form-label"></label>
        <input asp-for="CurrentPassword" class="form-control" autofocus />
        <span asp-validation-for="CurrentPassword" class="text-elara-accent small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label"></label>
        <input asp-for="NewPassword" class="form-control" />
        <span asp-validation-for="NewPassword" class="text-elara-accent small"></span>
    </div>
    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" />
        <span asp-validation-for="ConfirmPassword" class="text-elara-accent small"></span>
    </div>
    <button type="submit" class="btn btn-elara w-100 mb-3">Actualizar contraseña</button>
</form>

<form asp-controller="Account" asp-action="Logout" method="post" class="text-center">
    <button type="submit" class="btn btn-link btn-sm text-elara-muted">Cerrar sesión</button>
</form>
