@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Restablecer contraseña";
}

<h2 class="h4 mb-1">Restablecer contraseña</h2>
<p class="text-elara-muted mb-4">Ingresa tu nueva contraseña.</p>

<div asp-validation-summary="ModelOnly" class="text-elara-accent mb-3"></div>

<form asp-controller="Account" asp-action="ResetPassword" method="post">
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Token" />
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autofocus />
        <span asp-validation-for="Password" class="text-elara-accent small"></span>
    </div>
    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" />
        <span asp-validation-for="ConfirmPassword" class="text-elara-accent small"></span>
    </div>
    <button type="submit" class="btn btn-elara w-100">Restablecer contraseña</button>
</form>
