@model IEnumerable<Empleado>
@{
    ViewData["Title"] = "Empleados";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h1 class="h3 mb-1">Empleados</h1>
        <p class="text-elara-muted mb-0">Especialistas del salón: especialidades, horario y comisión.</p>
    </div>
    <a asp-controller="Empleados" asp-action="Create" class="btn btn-elara">
        <i class="bi bi-person-plus me-1"></i> Nuevo especialista
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert badge-elara-success mb-4">@TempData["SuccessMessage"]</div>
}

<div class="row g-4 stagger-fade-in">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card card-elara text-center py-5">
                <i class="bi bi-scissors fs-1 text-elara-accent"></i>
                <p class="text-elara-muted mt-3 mb-0">Aún no hay especialistas registrados.</p>
            </div>
        </div>
    }
    else
    {
        foreach (var empleado in Model)
        {
            var estadoBadge = empleado.Estado switch
            {
                EstadoEmpleado.Activo => "badge-elara-success",
                EstadoEmpleado.Vacaciones => "badge-elara-pending",
                _ => "badge-elara-danger"
            };

            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <div class="card card-elara h-100">
                    <div class="card-body text-center">
                        @if (!string.IsNullOrEmpty(empleado.FotoUrl))
                        {
                            <img src="@empleado.FotoUrl" alt="@empleado.NombreCompleto" class="elara-avatar-img mb-3" />
                        }
                        else
                        {
                            <div class="elara-avatar-placeholder mb-3">
                                <i class="bi bi-person-fill"></i>
                            </div>
                        }
                        <h5 class="card-title mb-1">@empleado.NombreCompleto</h5>
                        <p class="text-elara-muted small mb-2">
                            <i class="bi bi-percent me-1"></i>Comisión @empleado.ComisionPorcentaje.ToString("0.##")%
                        </p>

                        <div class="mb-2">
                            @foreach (var especialidad in empleado.EmpleadoEspecialidades.Take(3))
                            {
                                <span class="elara-tag">@especialidad.Especialidad?.Nombre</span>
                            }
                            @if (empleado.EmpleadoEspecialidades.Count > 3)
                            {
                                <span class="elara-tag">+@(empleado.EmpleadoEspecialidades.Count - 3)</span>
                            }
                        </div>

                        <span class="badge @estadoBadge mb-3">@empleado.Estado</span>

                        <div class="d-flex gap-2 justify-content-center flex-wrap">
                            <a asp-controller="Empleados" asp-action="Details" asp-route-id="@empleado.Id"
                               class="btn btn-sm btn-outline-elara" title="Ver detalle">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-controller="Empleados" asp-action="Edit" asp-route-id="@empleado.Id"
                               class="btn btn-sm btn-outline-elara" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-elara dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-toggle2-on"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @foreach (var estado in Enum.GetValues<EstadoEmpleado>())
                                    {
                                        <li>
                                            <form asp-controller="Empleados" asp-action="CambiarEstado" asp-route-id="@empleado.Id" method="post">
                                                <input type="hidden" name="estado" value="@estado" />
                                                <button type="submit" class="dropdown-item @(empleado.Estado == estado ? "active" : "")">
                                                    @estado
                                                </button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
