@model EmpleadoFormViewModel
@{
    ViewData["Title"] = "Nuevo especialista";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Nuevo especialista</h1>
    <p class="text-elara-muted">Se creará su perfil y una cuenta de acceso con contraseña temporal.</p>
</div>

<div class="card card-elara" style="max-width: 860px;">
    <div class="card-body p-4">
        <div asp-validation-summary="ModelOnly" class="text-elara-accent mb-3"></div>
        <form asp-controller="Empleados" asp-action="Create" method="post" enctype="multipart/form-data">
            <partial name="_EmpleadoForm" model="Model" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-elara">
                    <i class="bi bi-check2 me-1"></i> Guardar especialista
                </button>
                <a asp-controller="Empleados" asp-action="Index" class="btn btn-outline-elara">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/empleados.js" asp-append-version="true"></script>
}
